{
  "name": "mysql-mcp-tool",
  "version": "0.1.0",
  "description": "Model Context Protocol server for MySQL: read-only first, optional controlled writes. 面向 MySQL 的 Model Context Protocol 服务：只读优先、可选受控写入",
  "type": "module",
  "private": true,
  "bin": {
    "mysql-mcp-tool": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
